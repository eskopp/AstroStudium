{
  "name": "astrostudium",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "katex": "^0.19.1",
    "pagefind": "^1.6.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "astro": "^7.4.13"
  },
  "description": "Astro theme for study notes, lectures, exercises and labs with a module-scoped sidebar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eskopp/AstroStudium.git"
  },
  "keywords": [
    "astro-integration",
    "astro-theme",
    "withastro",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./integration/index.d.ts",
      "default": "./integration/index.mjs"
    },
    "./content": {
      "types": "./integration/content.d.ts",
      "default": "./integration/content.mjs"
    },
    "./tiles": "./theme/components/Tiles.astro"
  },
  "files": [
    "integration",
    "theme"
  ],
  "peerDependencies": {
    "astro": "^7.0.0"
  }
}
