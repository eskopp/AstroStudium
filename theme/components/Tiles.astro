---
interface Props {
  nodes: { title: string; href: string; description?: string; abgabe?: Date; status?: 'offen' | 'in-arbeit' | 'abgegeben' }[];
}

const { nodes } = Astro.props;

const statusLabel = { offen: 'offen', 'in-arbeit': 'in Arbeit', abgegeben: 'abgegeben' };
const statusClass = {
  offen: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300',
  'in-arbeit': 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300',
  abgegeben: 'bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300',
};
const formatDate = (date: Date) => date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<ul data-pagefind-ignore class="not-prose mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {nodes.map((node) => (
    <li>
      <a
        href={node.href}
        class="block h-full rounded-xl border border-neutral-200 p-4 transition hover:border-accent-500 dark:border-neutral-800"
      >
        <span class="flex flex-wrap items-start justify-between gap-x-2 gap-y-1">
          <span class="font-semibold">{node.title}</span>
          {node.status && (
            <span class:list={['shrink-0 rounded-full px-2 py-0.5 text-xs font-medium', statusClass[node.status]]}>{statusLabel[node.status]}</span>
          )}
        </span>
        {node.abgabe && <span class="mt-1 block text-sm text-neutral-500">Abgabe {formatDate(node.abgabe)}</span>}
        {node.description && !node.abgabe && <span class="mt-1 block text-sm text-neutral-500">{node.description}</span>}
      </a>
    </li>
  ))}
</ul>
