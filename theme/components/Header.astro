---
import config from 'virtual:astrostudium/config';
import { getTree, type NavNode } from '../lib/nav';
import SidebarItem from './SidebarItem.astro';

const { name, logo } = config;
const root = await getTree();
const menu = config.menu.length > 0 ? config.menu : root.children.map((s) => ({ label: s.title, href: s.href }));

interface Props {
  current: string;
  scope?: NavNode;
}

const { current, scope } = Astro.props;
const isActive = (href?: string) => !!href && href !== '/' && current.split('/')[0] === href.split('/')[1];
---

<header class="sticky top-0 z-20 border-b border-neutral-200 bg-white/80 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/80">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 md:gap-6">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      {logo && <img src={logo} alt="" class="h-7 w-7" />}
      {name}
    </a>
    <nav class="hidden flex-1 items-center gap-1 text-sm md:flex">
      {menu.map((item) => (
        <div class="group relative">
          {item.href ? (
            <a
              href={item.href}
              class:list={['block rounded-md px-3 py-1.5 hover:bg-neutral-100 dark:hover:bg-neutral-900', isActive(item.href) ? 'font-medium text-neutral-950 dark:text-white' : 'text-neutral-500']}
            >
              {item.label}
            </a>
          ) : (
            <button type="button" class="flex items-center gap-1 rounded-md px-3 py-1.5 text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-900">
              {item.label}
            </button>
          )}
          {item.children && (
            <div class="invisible absolute left-0 top-full min-w-48 pt-1 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
              <ul class="rounded-lg border border-neutral-200 bg-white p-1 shadow-lg dark:border-neutral-800 dark:bg-neutral-950">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block rounded-md px-3 py-1.5 text-neutral-600 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </nav>
    <span class="flex-1 md:hidden"></span>
    <button id="search-open" class="rounded-md border border-neutral-200 px-3 py-1 text-sm text-neutral-500 dark:border-neutral-800">
      <span class="hidden sm:inline">Suchen…</span><span class="sm:hidden">Suche</span>
    </button>
    <button id="theme-toggle" class="rounded-md p-2 text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-900" aria-label="Design wechseln">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path></svg>
    </button>
    <button id="menu-toggle" class="rounded-md p-2 text-neutral-500 hover:bg-neutral-100 md:hidden dark:hover:bg-neutral-900" aria-label="Menü" aria-expanded="false" aria-controls="mobile-menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>

  <div id="mobile-menu" hidden class="max-h-[calc(100vh-3.5rem)] overflow-y-auto border-t border-neutral-200 px-4 py-3 text-sm md:hidden dark:border-neutral-800">
    <ul class="space-y-1">
      {menu.map((item) => (
        <li>
          {item.href ? (
            <a href={item.href} class="block rounded-md px-2 py-2 font-medium">{item.label}</a>
          ) : (
            <span class="block px-2 py-2 text-xs font-semibold uppercase tracking-wide text-neutral-500">{item.label}</span>
          )}
          {item.children && (
            <ul class="ml-3 border-l border-neutral-200 dark:border-neutral-800">
              {item.children.map((child) => (
                <li><a href={child.href} class="block px-3 py-2 text-neutral-600 dark:text-neutral-400">{child.label}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    {scope && (
      <div class="mt-3 border-t border-neutral-200 pt-3 dark:border-neutral-800">
        <a href={scope.href} class="block px-2 py-1 font-semibold tracking-tight">{scope.title}</a>
        <ul class="mt-1 space-y-1 border-l border-neutral-200 dark:border-neutral-800">
          {scope.children.map((child) => <SidebarItem node={child} current={current} />)}
        </ul>
      </div>
    )}
  </div>
</header>

<dialog id="search-dialog" class="m-auto mt-20 w-full max-w-xl rounded-xl border border-neutral-200 bg-white p-4 text-neutral-900 backdrop:bg-black/40 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-100">
  <div id="search"></div>
</dialog>

<script>
  const menuButton = document.getElementById('menu-toggle') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
  menuButton?.addEventListener('click', () => {
    const open = mobileMenu.hidden;
    mobileMenu.hidden = !open;
    menuButton.setAttribute('aria-expanded', String(open));
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  let loaded = false;

  async function openSearch() {
    dialog.showModal();
    if (!loaded) {
      loaded = true;
      try {
        const base = '/pagefind/pagefind-ui';
        await new Promise<void>((resolve, reject) => {
          const css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = `${base}.css`;
          document.head.append(css);
          const js = document.createElement('script');
          js.src = `${base}.js`;
          js.onload = () => resolve();
          js.onerror = () => reject();
          document.head.append(js);
        });
        // @ts-expect-error provided by pagefind-ui.js
        new PagefindUI({ element: '#search', showSubResults: false, autofocus: true });
      } catch {
        document.getElementById('search')!.textContent = 'Die Suche gibt es nur im gebauten Stand (npm run build).';
      }
    }
  }

  document.getElementById('search-open')?.addEventListener('click', openSearch);
  addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>
