---
import config from 'virtual:astrostudium/config';
import { getTree, type NavNode } from '../lib/nav';
import SidebarItem from './SidebarItem.astro';

const { name, logo } = config;
const root = await getTree();
const menu = config.menu ?? root.children.map((s) => ({ label: s.title, href: s.href }));

interface Props {
  current: string;
  scope?: NavNode;
}

const { current, scope } = Astro.props;
const isActive = (href?: string) => !!href && href !== '/' && current.split('/')[0] === href.split('/')[1];
---

<header class="sticky top-0 z-20 border-b border-neutral-200 bg-white/80 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/80">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 md:gap-6">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      {logo && <img src={logo} alt="" class="h-7 w-7" />}
      {name}
    </a>
    <nav class="hidden flex-1 items-center gap-1 text-sm md:flex">
      {menu.map((item) => (
        <div class="group relative">
          {item.href ? (
            <a
              href={item.href}
              class:list={['block rounded-md px-3 py-1.5 hover:bg-neutral-100 dark:hover:bg-neutral-900', isActive(item.href) ? 'font-medium text-neutral-950 dark:text-white' : 'text-neutral-500']}
            >
              {item.label}
            </a>
          ) : (
            <button type="button" class="flex items-center gap-1 rounded-md px-3 py-1.5 text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-900">
              {item.label}
            </button>
          )}
          {item.children && (
            <div class="invisible absolute left-0 top-full min-w-48 pt-1 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
              <ul class="rounded-lg border border-neutral-200 bg-white p-1 shadow-lg dark:border-neutral-800 dark:bg-neutral-950">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block rounded-md px-3 py-1.5 text-neutral-600 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </nav>
    <span class="flex-1 md:hidden"></span>
    <div data-search class="relative hidden md:block">
      <input
        type="search"
        placeholder="Suchen…"
        aria-label="Suchen"
        autocomplete="off"
        class="w-56 [&::-webkit-search-cancel-button]:appearance-none rounded-lg border border-neutral-200 bg-neutral-100/60 py-1.5 pl-3 pr-14 text-sm outline-none placeholder:text-neutral-500 focus:border-accent-500 dark:border-neutral-800 dark:bg-neutral-900/60"
      />
      <kbd class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-neutral-300 px-1.5 text-[10px] text-neutral-500 dark:border-neutral-700">Strg K</kbd>
      <div data-results hidden class="absolute right-0 top-full z-30 mt-2 max-h-[70vh] w-[30rem] max-w-[90vw] overflow-y-auto rounded-xl border border-neutral-200 bg-white p-2 shadow-xl dark:border-neutral-800 dark:bg-neutral-950"></div>
    </div>
    <button id="search-open" class="rounded-md p-2 text-neutral-500 hover:bg-neutral-100 md:hidden dark:hover:bg-neutral-900" aria-label="Suchen" aria-expanded="false" aria-controls="mobile-search">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    </button>
    <button id="theme-toggle" class="rounded-md p-2 text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-900" aria-label="Design wechseln">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path></svg>
    </button>
    {(menu.length > 0 || scope) && <button id="menu-toggle" class="rounded-md p-2 text-neutral-500 hover:bg-neutral-100 md:hidden dark:hover:bg-neutral-900" aria-label="Menü" aria-expanded="false" aria-controls="mobile-menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>}
  </div>

  <div id="mobile-search" hidden class="border-t border-neutral-200 px-4 py-3 md:hidden dark:border-neutral-800">
    <div data-search class="relative">
      <input
        type="search"
        placeholder="Suchen…"
        aria-label="Suchen"
        autocomplete="off"
        class="w-full [&::-webkit-search-cancel-button]:appearance-none rounded-lg border border-neutral-200 bg-neutral-100/60 px-3 py-2 text-sm outline-none placeholder:text-neutral-500 focus:border-accent-500 dark:border-neutral-800 dark:bg-neutral-900/60"
      />
      <div data-results hidden class="absolute left-0 right-0 top-full z-30 mt-2 max-h-[60vh] overflow-y-auto rounded-xl border border-neutral-200 bg-white p-2 shadow-xl dark:border-neutral-800 dark:bg-neutral-950"></div>
    </div>
  </div>

  <div id="mobile-menu" hidden class="max-h-[calc(100vh-3.5rem)] overflow-y-auto border-t border-neutral-200 px-4 py-3 text-sm md:hidden dark:border-neutral-800">
    <ul class="space-y-1">
      {menu.map((item) => (
        <li>
          {item.href ? (
            <a href={item.href} class="block rounded-md px-2 py-2 font-medium">{item.label}</a>
          ) : (
            <span class="block px-2 py-2 text-xs font-semibold uppercase tracking-wide text-neutral-500">{item.label}</span>
          )}
          {item.children && (
            <ul class="ml-3 border-l border-neutral-200 dark:border-neutral-800">
              {item.children.map((child) => (
                <li><a href={child.href} class="block px-3 py-2 text-neutral-600 dark:text-neutral-400">{child.label}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    {scope && (
      <div class="mt-3 border-t border-neutral-200 pt-3 dark:border-neutral-800">
        <a href={scope.href} class="block px-2 py-1 font-semibold tracking-tight">{scope.title}</a>
        <ul class="mt-1 space-y-1 border-l border-neutral-200 dark:border-neutral-800">
          {scope.children.map((child) => <SidebarItem node={child} current={current} />)}
        </ul>
      </div>
    )}
  </div>
</header>

<script>
  const menuButton = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
  const searchButton = document.getElementById('search-open') as HTMLButtonElement;
  const mobileSearch = document.getElementById('mobile-search') as HTMLElement;

  function toggleRow(button: HTMLButtonElement, row: HTMLElement, other?: { button: HTMLButtonElement | null; row: HTMLElement }) {
    const open = row.hidden;
    row.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    if (open && other) {
      other.row.hidden = true;
      other.button?.setAttribute('aria-expanded', 'false');
    }
    return open;
  }

  menuButton?.addEventListener('click', () => toggleRow(menuButton, mobileMenu, { button: searchButton, row: mobileSearch }));
  searchButton?.addEventListener('click', () => {
    if (toggleRow(searchButton, mobileSearch, { button: menuButton, row: mobileMenu })) {
      mobileSearch.querySelector('input')?.focus();
    }
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });

  // Search: Pagefind index with a Hextra style result list.
  let pagefind: any;
  let failed = false;

  async function loadPagefind() {
    if (pagefind || failed) return pagefind;
    try {
      const url = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ url);
      await pagefind.init();
    } catch {
      failed = true;
    }
    return pagefind;
  }

  function el(tag: string, className: string, text?: string) {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  const linkClass = 'block rounded-lg px-3 py-2 outline-none hover:bg-neutral-100 focus:bg-neutral-100 dark:hover:bg-neutral-900 dark:focus:bg-neutral-900';

  function resultLink(url: string, title: string, excerpt: string) {
    const a = el('a', linkClass) as HTMLAnchorElement;
    a.href = url;
    a.append(el('div', 'text-sm font-medium', title));
    if (excerpt) {
      const p = el('div', 'mt-0.5 text-xs text-neutral-500 [&_mark]:rounded [&_mark]:bg-yellow-200 [&_mark]:px-0.5 [&_mark]:text-neutral-900 dark:[&_mark]:bg-yellow-500/40 dark:[&_mark]:text-white');
      p.innerHTML = excerpt;
      a.append(p);
    }
    return a;
  }

  function render(out: HTMLElement, pages: any[]) {
    if (pages.length === 0) {
      out.replaceChildren(el('div', 'px-3 py-6 text-center text-sm text-neutral-500', 'Keine Ergebnisse.'));
      return;
    }
    out.replaceChildren(
      ...pages.map((page) => {
        const group = el('div', 'py-1');
        if (page.meta?.crumbs) group.append(el('div', 'px-3 pt-1 text-[11px] uppercase tracking-wide text-neutral-400', page.meta.crumbs));
        const subs = (page.sub_results ?? []).filter((r: any) => r.url !== page.url).slice(0, 3);
        group.append(resultLink(page.url, page.meta?.title ?? page.url, subs.length ? '' : page.excerpt));
        for (const sub of subs) {
          const link = resultLink(sub.url, sub.title, sub.excerpt);
          link.classList.add('ml-3', 'border-l', 'border-neutral-200', 'dark:border-neutral-800', 'rounded-l-none');
          group.append(link);
        }
        return group;
      }),
    );
  }

  function setupSearch(box: HTMLElement) {
    const input = box.querySelector('input') as HTMLInputElement;
    const out = box.querySelector('[data-results]') as HTMLElement;
    let token = 0;

    const items = () => Array.from(out.querySelectorAll<HTMLAnchorElement>('a'));
    const close = () => { out.hidden = true; };

    async function run() {
      const query = input.value.trim();
      const mine = ++token;
      if (!query) return close();
      out.hidden = false;
      if (!out.childElementCount) out.replaceChildren(el('div', 'px-3 py-6 text-center text-sm text-neutral-500', 'Suche…'));
      const pf = await loadPagefind();
      if (mine !== token) return;
      if (!pf) {
        out.replaceChildren(el('div', 'px-3 py-6 text-center text-sm text-neutral-500', 'Die Suche gibt es nur im gebauten Stand (npm run build).'));
        return;
      }
      const search = await pf.debouncedSearch(query, {}, 120);
      if (!search || mine !== token) return;
      const pages = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
      if (mine !== token) return;
      render(out, pages);
    }

    input.addEventListener('input', run);
    input.addEventListener('focus', () => { if (input.value.trim() && out.childElementCount) out.hidden = false; });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); items()[0]?.focus(); }
      if (e.key === 'Escape') { close(); input.blur(); }
      if (e.key === 'Enter') items()[0]?.click();
    });
    out.addEventListener('keydown', (e) => {
      const list = items();
      const index = list.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') { e.preventDefault(); list[Math.min(index + 1, list.length - 1)]?.focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); if (index <= 0) input.focus(); else list[index - 1].focus(); }
      if (e.key === 'Escape') { close(); input.focus(); }
    });
    document.addEventListener('click', (e) => { if (!box.contains(e.target as Node)) close(); });
  }

  document.querySelectorAll<HTMLElement>('[data-search]').forEach(setupSearch);

  addEventListener('keydown', (e) => {
    if (!((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) return;
    e.preventDefault();
    if (matchMedia('(min-width: 768px)').matches) {
      document.querySelector<HTMLInputElement>('header div[data-search] input')?.focus();
    } else {
      if (mobileSearch.hidden) searchButton.click();
      else mobileSearch.querySelector('input')?.focus();
    }
  });
</script>
