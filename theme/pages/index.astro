---
import Layout from '../layouts/Layout.astro';
import Tiles from '../components/Tiles.astro';
import { getTree } from '../lib/nav';
import config from 'virtual:astrostudium/config';

const root = await getTree();
---

<Layout title={config.name}>
  <h1 class="text-4xl font-bold tracking-tight">{config.name}</h1>
  <p class="mt-3 text-lg text-neutral-500">Studium, Praktika und Blog an einem Ort.</p>
  <Tiles nodes={root.children} />
</Layout>
