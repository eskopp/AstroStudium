---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Tiles from '../components/Tiles.astro';
import ModuleTabs from '../components/ModuleTabs.astro';
import config from 'virtual:astrostudium/config';
import { breadcrumbs, findNode, getTree, leaves, moduleTabs } from '../lib/nav';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  const toPath = (id: string) => id.replace(/(^|\/)index$/, '');
  const pages = entries
    .map((entry) => ({ entry, path: toPath(entry.id) }))
    .filter(({ path }) => path !== '')
    .map(({ entry, path }) => ({ params: { slug: path }, props: { entry, path } }));

  const taken = new Set(pages.map((p) => p.params.slug));
  const redirects = entries.flatMap((entry) => {
    const target = toPath(entry.id);
    return entry.data.aliases
      .map((alias) => alias.replace(/^\/+|\/+$/g, ''))
      .filter((alias) => alias !== '' && !taken.has(alias))
      .map((alias) => ({ params: { slug: alias }, props: { redirectTo: target ? `/${target}/` : '/' } }));
  });

  return [...pages, ...redirects];
}

const { entry, path, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo);

const { Content } = await render(entry);
const root = await getTree();
const node = findNode(root, path)!;
const crumbs = breadcrumbs(root, path);

const mod = findNode(root, path.split('/').slice(0, 2).join('/'));
const tabs = mod && path.split('/').length >= 2 ? moduleTabs(mod) : [];
const kindRoot = tabs.find((t) => path === t.path || path.startsWith(`${t.path}/`));
const pages = kindRoot ? leaves(kindRoot) : mod ? leaves(mod) : [];
const index = pages.findIndex((p) => p.path === path);
const prev = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 ? pages[index + 1] : undefined;
---

<Layout title={entry.data.title} description={entry.data.description} path={path}>
  <nav class="mb-4 flex flex-wrap gap-1 text-sm text-neutral-500" aria-label="Pfad">
    <a href="/" class="hover:text-neutral-900 dark:hover:text-white">Start</a>
    {crumbs.slice(0, -1).map((c) => (
      <>
        <span>›</span>
        <a href={c.href} class="hover:text-neutral-900 dark:hover:text-white">{c.title}</a>
      </>
    ))}
  </nav>

  {mod && tabs.length > 0 && <ModuleTabs mod={mod} tabs={tabs} current={path} />}

  <article data-pagefind-body class="prose prose-neutral max-w-3xl dark:prose-invert">
    <h1>{entry.data.title}</h1>
    {entry.data.description && <p class="lead">{entry.data.description}</p>}
    <Content />
    {node.children.length > 0 && entry.data.tiles && (
      <>
        <h2>Inhalt</h2>
        <Tiles nodes={node.children} />
      </>
    )}
  </article>

  {config.editUrl && entry.filePath && (
    <p class="mt-8 max-w-3xl text-sm text-neutral-500">
      <a href={`${config.editUrl}${entry.filePath}`} class="hover:text-neutral-900 dark:hover:text-white">Diese Seite auf GitHub bearbeiten →</a>
    </p>
  )}

  {(prev || next) && (
    <nav class="mt-12 flex max-w-3xl justify-between gap-4 border-t border-neutral-200 pt-6 text-sm dark:border-neutral-800">
      {prev ? <a href={prev.href} class="hover:text-accent-600">← {prev.title}</a> : <span />}
      {next ? <a href={next.href} class="hover:text-accent-600">{next.title} →</a> : <span />}
    </nav>
  )}
</Layout>
